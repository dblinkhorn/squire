{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "canonical_object_v1.json",
  "title": "Canonical Object v1",
  "type": "object",
  "allOf": [
    { "$ref": "#/definitions/base" },
    {
      "oneOf": [
        { "$ref": "#/definitions/people" },
        { "$ref": "#/definitions/projects" },
        { "$ref": "#/definitions/ideas" },
        { "$ref": "#/definitions/admin" }
      ]
    }
  ],
  "unevaluatedProperties": false,
  "definitions": {
    "base": {
      "type": "object",
      "required": ["id", "type", "title", "created_at", "updated_at", "archived"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "type": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "archived": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "rel"],
            "properties": {
              "to": { "type": "string" },
              "rel": { "type": "string" }
            }
          }
        },
        "source_event_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "people": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "type": { "const": "people" },
        "name": { "type": "string" },
        "context": { "type": "string" },
        "follow_ups": { "type": "string" },
        "last_contacted": { "type": "string" },
        "next_contact": { "type": "string" }
      }
    },
    "projects": {
      "type": "object",
      "required": ["status", "next_action"],
      "properties": {
        "type": { "const": "projects" },
        "status": {
          "type": "string",
          "enum": ["planning", "in_progress", "blocked", "completed", "on_hold"]
        },
        "next_action": { "type": "string" },
        "goal": { "type": "string" },
        "due": { "type": "string" },
        "blocked_reason": { "type": "string" },
        "stakeholders": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "ideas": {
      "type": "object",
      "required": ["one_liner"],
      "properties": {
        "type": { "const": "ideas" },
        "one_liner": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["seed", "incubating", "active", "parked", "done"]
        },
        "next_step": { "type": "string" }
      }
    },
    "admin": {
      "type": "object",
      "required": ["status", "next_action"],
      "properties": {
        "type": { "const": "admin" },
        "status": {
          "type": "string",
          "enum": ["open", "done", "blocked"]
        },
            "next_action": { "type": "string" },
            "due_date": { "type": "string" },
            "due_at": { "type": "string", "format": "date-time" },
            "priority": { "type": "string", "enum": ["low", "normal", "high"] },
        "blocked_reason": { "type": "string" },
        "completed_at": { "type": "string", "format": "date-time" },
        "gcal_event_id": { "type": "string" }
      }
    }
  }
}
