{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "decision_v1.json",
  "title": "Decision Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "raw_event_id",
    "object_type",
    "confidence",
    "candidates",
    "proposed_operations",
    "model",
    "prompt_version",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "raw_event_id": { "type": ["string", "null"] },
    "object_type": {
      "type": "string",
      "enum": ["people", "projects", "ideas", "admin"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/definitions/candidate" }
    },
    "proposed_operations": {
      "type": "array",
      "items": { "$ref": "#/definitions/operation" }
    },
    "model": { "type": ["string", "null"] },
    "prompt_version": { "type": ["string", "null"] },
    "timestamp": { "type": ["string", "null"], "format": "date-time" }
  },
  "definitions": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "snippet", "score"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "snippet": { "type": "string" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_id"],
      "properties": {
        "op": {
          "type": ["string", "null"],
          "enum": ["create", "update", "append", "unknown", null]
        },
        "target_id": { "type": ["string", "null"] }
      }
    }
  }
}
