{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derived_event_projects_v1.json",
  "title": "DerivedEvent Projects v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "raw_event_id",
    "object_type",
    "intent",
    "extracted_fields",
    "confidence",
    "proposed_operations",
    "model",
    "prompt_version",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "raw_event_id": { "type": ["string", "null"] },
    "object_type": { "type": "string", "const": "projects" },
    "intent": {
      "type": ["string", "null"],
      "enum": ["create", "update", "append", "unknown", null]
    },
    "extracted_fields": { "$ref": "#/definitions/projects_fields" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "proposed_operations": {
      "type": "array",
      "items": { "$ref": "#/definitions/operation" }
    },
    "model": { "type": ["string", "null"] },
    "prompt_version": { "type": ["string", "null"] },
    "timestamp": { "type": ["string", "null"], "format": "date-time" }
  },
  "definitions": {
    "projects_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "status",
        "next_action",
        "goal",
        "due",
        "blocked_reason",
        "stakeholders"
      ],
      "properties": {
        "title": { "type": ["string", "null"] },
        "status": {
          "type": ["string", "null"],
          "enum": ["planning", "in_progress", "blocked", "completed", "on_hold", null]
        },
        "next_action": { "type": ["string", "null"] },
        "goal": { "type": ["string", "null"] },
        "due": { "type": ["string", "null"] },
        "blocked_reason": { "type": ["string", "null"] },
        "stakeholders": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target_id", "fields"],
      "properties": {
        "op": {
          "type": ["string", "null"],
          "enum": ["create", "update", "append", "unknown", null]
        },
        "target_id": { "type": ["string", "null"] },
        "fields": { "$ref": "#/definitions/projects_fields" }
      }
    }
  }
}
