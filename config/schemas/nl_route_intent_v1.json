{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nl_route_intent_v1.json",
  "title": "Natural Language Route Intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route",
    "intent",
    "risk_tier",
    "confidence",
    "ambiguities",
    "read_command",
    "mutation_plan",
    "clarification"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "route": {
      "type": "string",
      "enum": [
        "read_command",
        "mutation_plan",
        "clarify",
        "capture_fallthrough",
        "blocked_explicit_only"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "status",
        "weekly",
        "recent",
        "find",
        "show",
        "done",
        "append",
        "fix",
        "clear_archive",
        "confirm_pending",
        "cancel_pending",
        "none"
      ]
    },
    "risk_tier": {
      "type": "string",
      "enum": ["read", "mutation", "destructive", "control", "none"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "ambiguities": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    },
    "read_command": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["intent", "args"],
      "properties": {
        "intent": {
          "type": "string",
          "enum": ["status", "weekly", "recent", "find", "show"]
        },
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "number", "query", "text", "recent_limit"],
          "properties": {
            "target": {
              "type": ["string", "null"]
            },
            "number": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "query": {
              "type": ["string", "null"]
            },
            "text": {
              "type": ["string", "null"]
            },
            "recent_limit": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          }
        }
      }
    },
    "mutation_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "operations",
        "raw_user_phrases",
        "confidence",
        "object_type_hint",
        "requires_clarification",
        "clarification_reason"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "operations": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation_id",
              "action_type",
              "target_refs",
              "field_updates",
              "append_text",
              "raw_user_phrases",
              "confidence",
              "requires_clarification",
              "clarification_reason"
            ],
            "properties": {
              "operation_id": {
                "type": "string"
              },
              "action_type": {
                "type": "string",
                "enum": ["mark_done", "append_body", "set_fields"]
              },
              "target_refs": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "value"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["row_number", "object_id"]
                    },
                    "value": {
                      "type": ["integer", "string"]
                    }
                  }
                }
              },
              "field_updates": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value_text", "source_phrase", "field_candidates"],
                  "properties": {
                    "value_text": {
                      "type": "string"
                    },
                    "source_phrase": {
                      "type": ["string", "null"]
                    },
                    "field_candidates": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["primary", "alternates"],
                      "properties": {
                        "primary": {
                          "type": ["object", "null"],
                          "additionalProperties": false,
                          "required": ["field_id", "confidence"],
                          "properties": {
                            "field_id": {
                              "type": "string"
                            },
                            "confidence": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            }
                          }
                        },
                        "alternates": {
                          "type": "array",
                          "maxItems": 4,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["field_id", "confidence"],
                            "properties": {
                              "field_id": {
                                "type": "string"
                              },
                              "confidence": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "append_text": {
                "type": ["string", "null"]
              },
              "raw_user_phrases": {
                "type": ["object", "null"],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "requires_clarification": {
                "type": "boolean"
              },
              "clarification_reason": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "raw_user_phrases": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "object_type_hint": {
          "type": ["string", "null"],
          "enum": ["admin", "projects", "people", "ideas", null]
        },
        "requires_clarification": {
          "type": "boolean"
        },
        "clarification_reason": {
          "type": ["string", "null"]
        }
      }
    },
    "clarification": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": {
          "type": ["string", "null"]
        },
        "options": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
