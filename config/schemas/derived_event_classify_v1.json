{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "derived_event_classify_v1.json",
  "title": "DerivedEvent Classification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_type", "confidence"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "object_type": {
      "type": "string",
      "enum": ["people", "projects", "ideas", "admin", "unknown"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
