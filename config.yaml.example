# Example configuration for local development

llm:
  interpreter_model: gpt-5-mini
  classify_prompt_path: "config/prompts/classify_v1.txt"
  interpreter_prompt_path: "config/prompts/extract_v1.txt"

timezone: "local" # Use system local timezone, or set an IANA name like "America/Los_Angeles".

archive_root: "~/squire-archive" # Default archive location. Override to move durable storage.
archive_git_enabled: true # Set false to skip git initialization for the archive.

paths:
  events_raw: "events/raw"
  events_derived: "events/derived"
  objects_root: "objects"
  index_db: "index/sb.sqlite"

confidence:
  create_threshold: 0.6

schedule:
  daily_digest_time: "09:00"

surfacing:
  admin:
    due_soon_days: 1
    include_open_limit: 5
  projects:
    stale_days: 14
  ideas:
    weekly_review: true
  people:
    next_contact_days: 0

querying:
  execute_threshold: 0.8
  confirm_threshold: 0.6
